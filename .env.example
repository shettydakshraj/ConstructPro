# ========================================================
# ConstructPro Environment Variables Template
# Copy this file to .env for local environment configuration
# ========================================================

# Server Port (Render sets this dynamically in production)
PORT=8081

# Production Neon PostgreSQL Connection String
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database>?sslmode=require

# Optional Local Oracle Database Settings (used only when DATABASE_URL is not set)
ORACLE_URL=jdbc:oracle:thin:@localhost:1521:XE
ORACLE_USER=system
ORACLE_PASSWORD=1
